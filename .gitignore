# ---- the Hogwarts theme's pictures (upstream fan art): NOT covered by the code licence, never committed.
# scripts/fetch-fanart.sh downloads them from the upstream repo for a personal build.
home/img/logos/
home/themes/hogwarts/img/*.jpg
home/themes/hogwarts/img/*.png
home/themes/hogwarts/owl/*.webp
home/themes/hogwarts/owl/*.webm
home/themes/hogwarts/owl/src/
home/themes/hogwarts/covers/
android/app/src/main/assets/www/img/logos/
android/app/src/main/assets/www/themes/hogwarts/img/*.jpg
android/app/src/main/assets/www/themes/hogwarts/img/*.png
android/app/src/main/assets/www/themes/hogwarts/owl/*.webp
android/app/src/main/assets/www/themes/hogwarts/owl/*.webm
android/app/src/main/assets/www/themes/hogwarts/covers/
