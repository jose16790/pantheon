docs/hogwarts-tv-home/docs/

# per-TV undo lists written by scripts/unbloat.sh
scripts/tvs/

# the dragon and fire source clips (~30 MB): only needed to re-cut the sprites (themes/got/tools/dragon_sprites.py, fire_sprites.py)
home/themes/got/dragon/src/*.mp4

# your own music for the Game of Thrones theme (scripts/add-music.sh): local only, never committed
home/themes/got/sounds/music-local.*
android/app/src/main/assets/www/themes/got/sounds/music-local.*
