<?xml version="1.0" encoding="utf-8"?>
<!-- Pantheon's Home watch (home/HomeWatch.java): "a window came forward" events from Google's two home apps, and
     the Home key (seen, never blocked: it only notes when Home was pressed). It reads nothing on screen. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:packageNames="com.google.android.apps.tv.launcherx,com.google.android.tvlauncher"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="0"
    android:canRetrieveWindowContent="false"
    android:canRequestFilterKeyEvents="true"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:description="@string/home_watch_description" />
